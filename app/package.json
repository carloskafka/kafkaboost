{
    "name": "legion-tuning-wizard",
    "productName": "KafkaBoost",
    "version": "0.1.0",
    "description": "Step-by-step wizard that applies the ThrottleStop undervolt/boost/power tuning for the Lenovo Legion 83DE (i9-14900HX).",
    "main": "src/main.js",
    "author": "carloskafka",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "start": "electron .",
        "demo": "node -e \"process.env.WIZARD_DEMO=1;require('child_process').spawn(require('electron'),['.'],{stdio:'inherit',env:process.env})\"",
        "icons": "electron ../tools/make-icons.js",
        "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/Create-Shortcut.ps1",
        "dist": "electron-builder --win",
        "test": "node --test \"test/*.test.js\""
    },
    "build": {
        "appId": "dev.carloskafka.legion-tuning-wizard",
        "productName": "KafkaBoost",
        "files": [
            "src/**/*",
            "renderer/**/*",
            "build/*.png"
        ],
        "extraResources": [
            {
                "from": "../scripts",
                "to": "scripts",
                "filter": [
                    "**/*.ps1"
                ]
            },
            {
                "from": "../config",
                "to": "config"
            }
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "requestedExecutionLevel": "requireAdministrator",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "publish": [
            {
                "provider": "github",
                "owner": "carloskafka",
                "repo": "legion-14900hx-throttlestop"
            }
        ]
    },
    "devDependencies": {
        "electron": "^44.7.0"
    },
    "dependencies": {
        "electron-updater": "^6.8.9"
    }
}
