{
  "version": 1,
  "categories": ["performance", "gpu", "gaming", "network", "privacy", "appearance", "general"],
  "tweaks": [
    {
      "id": "power-plan-performance", "category": "performance", "risk": "advanced", "recommended": false, "needsReboot": false,
      "actions": [ { "type": "powerplan" } ]
    },
    {
      "id": "fast-startup-off", "category": "performance", "risk": "safe", "recommended": true, "needsReboot": false,
      "actions": [ { "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power", "name": "HiberbootEnabled", "kind": "DWord", "on": 0, "off": 1 } ]
    },
    {
      "id": "background-apps-off", "category": "performance", "risk": "safe", "recommended": true, "needsReboot": false,
      "actions": [ { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppPrivacy", "name": "LetAppsRunInBackground", "kind": "DWord", "on": 2, "off": null } ]
    },
    {
      "id": "delivery-optimization-off", "category": "performance", "risk": "safe", "recommended": true, "needsReboot": false,
      "actions": [ { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization", "name": "DODownloadMode", "kind": "DWord", "on": 0, "off": null } ]
    },
    {
