{
  "version": 1,
  "exeName": "cs2.exe",
  "steamAppId": 730,
  "defaultFolder": "Counter-Strike Global Offensive",
  "autoexecMarker": "// Written by KafkaBoost",
  "autoexec": [
    { "id": "showfps", "line": "cl_showfps 1", "comment": "Shows the frame counter in a corner of the screen, so you can see stutter while you play." },
    { "id": "fpsmax", "line": "fps_max {value}", "comment": "Frame-rate limit (the Video menu has the same setting). A limit your PC can hold steadily keeps CPU and GPU load, and so heat, lower.", "param": { "name": "value", "min": 30, "max": 1000 } }
  ],
  "videoMarker": "// Written by KafkaBoost",
  "video": [
    { "id": "res-width", "settingKey": "setting.defaultres", "comment": "Horizontal resolution in pixels. Must be one your monitor actually supports.", "param": { "name": "value", "min": 640, "max": 7680 } },
    { "id": "res-height", "settingKey": "setting.defaultresheight", "comment": "Vertical resolution in pixels. Must be one your monitor actually supports.", "param": { "name": "value", "min": 480, "max": 4320 } },
    { "id": "refresh-rate", "settingKey": "setting.refreshrate_numerator", "comment": "Refresh rate in Hz. Must match what your monitor and its cable/port actually support, or the game may show the wrong rate until you fix it again in the in-game Video menu.", "param": { "name": "value", "min": 30, "max": 500 }, "also": [ { "settingKey": "setting.refreshrate_denominator", "value": "1" } ] }
  ],
  "launch": [
    { "id": "exec", "text": "+exec autoexec", "tier": "suggested", "default": true },
    { "id": "console", "text": "-console", "tier": "suggested", "default": false },
    { "id": "high", "text": "-high", "tier": "disputed", "default": false },
    { "id": "vulkan", "text": "-vulkan", "tier": "disputed", "default": false },
    { "id": "novid", "text": "-novid", "tier": "placebo", "default": false },
    { "id": "nojoy", "text": "-nojoy", "tier": "placebo", "default": false }
  ]
}
